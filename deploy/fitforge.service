[Unit]
Description=fitforge (fitforge.aryadubey.tech) - Django on gunicorn
After=network.target postgresql.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/fitforge
EnvironmentFile=/var/www/fitforge-shared/.env
Environment=DJANGO_SETTINGS_MODULE=gym_site.settings
ExecStart=/var/www/fitforge-shared/venv/bin/gunicorn --bind 127.0.0.1:8102 --workers 2 --timeout 120 gym_site.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
